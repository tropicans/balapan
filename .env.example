# ===================================================
# DGDash Racing System - Production Environment Config
# ===================================================

# Node Environment: 'production' or 'development'
NODE_ENV=production

# Host Port Mapping (avoiding port 3000 conflicts)
HOST_PORT=3050

# Internal Container Port (default: 3000)
PORT=3000

# SQLite Database Storage Filepath inside container
DB_PATH=/app/data/tamiya.sqlite

# Demo seed data (dummy racers/race/bracket). Keep unset/false in production.
# Set to 'true' only for local demos or automated tests.
SEED_DEMO_DATA=false

# Destructive migrations flag (default: false). Only set to 'true' if running planned destructive schema drops.
ALLOW_DESTRUCTIVE_MIGRATION=false

# Google OAuth 2.0 Configuration (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Root Super Admin Email (auto-approved on login)
SUPER_ADMIN_EMAIL=tropicans@gmail.com

